# Server-side LiteLLM proxy for generated reply suggestions
# Use a virtual Listen2Me key with access limited to the configured aliases.
LITELLM_HOST=http://host.docker.internal:4000
LITELLM_SECRET=your_listen2me_virtual_key_here
LITELLM_FAST_MODEL=fast
LITELLM_CHEAP_MODEL=cheap
LITELLM_TIMEOUT_SECONDS=5

# Optional server-side OpenAI Realtime conversation adapter
OPENAI_API_KEY=your_server_side_api_key_here
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Reserved for a future server-side personal voice adapter
ELEVENLABS_API_KEY=
