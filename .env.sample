# Server-side LiteLLM proxy for generated reply suggestions
# Use a virtual Listen2Me key with access limited to the configured aliases.
LITELLM_HOST=http://host.docker.internal:4000
LITELLM_SECRET=your_listen2me_virtual_key_here
LITELLM_FAST_MODEL=fast
LITELLM_CHEAP_MODEL=cheap
LITELLM_TIMEOUT_SECONDS=5

# Optional Google sign-in. Create a Google OAuth client of type "Web
# application" and register the exact callback shown in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used behind a reverse proxy, for example https://listen2me.example
APP_ORIGIN=
# Keep false outside a local Docker preview on localhost or 127.0.0.1.
ALLOW_INSECURE_LOCAL_HTTP=false

# Primary server-side speech output and optional Realtime conversation adapter
OPENAI_API_KEY=your_server_side_api_key_here
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# OPENAI_CUSTOM_VOICE_ID=voice_...
OPENAI_TTS_FIRST_BYTE_TIMEOUT=8
OPENAI_TTS_TOTAL_TIMEOUT=20
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VAD_EAGERNESS=auto

# Optional comparison voices. They are selected explicitly, never used as an
# automatic fallback for OpenAI, and share one strict global daily character limit.
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=optional_public_or_custom_voice_id
CARTESIA_TTS_MODEL=sonic-3.5
CARTESIA_API_VERSION=2026-03-01
CARTESIA_TTS_TIMEOUT_SECONDS=12
CARTESIA_DAILY_CHARACTER_LIMIT=500

ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=optional_public_or_custom_voice_id
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_TIMEOUT_SECONDS=12
ELEVENLABS_DAILY_CHARACTER_LIMIT=300
