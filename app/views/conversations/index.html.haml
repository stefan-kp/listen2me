- content_for :title, t("conversation_history.index.page_title")

.l2m-page.l2m-history-page{"aria-labelledby": "conversation-history-title"}
  .l2m-history-heading
    %div
      %p.l2m-eyebrow= t("conversation_history.index.eyebrow")
      %h1#conversation-history-title= t("conversation_history.index.title")
      %p.l2m-history-lead= t("conversation_history.index.intro")

    = link_to new_conversation_path, class: "l2m-button l2m-history-new-button" do
      = heroicon "plus", options: { class: "h-5 w-5", "aria-hidden": "true" }
      %span= t("conversation_history.index.new_conversation")

  - if @conversation_history_items.any?
    .l2m-history-overview
      %p= t("conversation_history.index.conversation_count", count: @conversation_history_items.size)
      %p= t("conversation_history.index.resume_hint")

    %ol.l2m-history-list{"aria-label": t("conversation_history.index.list_label")}
      - @conversation_history_items.each do |item|
        - conversation = item.fetch(:conversation)
        - title = item[:title].presence || t("conversation_history.index.untitled", date: l(conversation.created_at, format: :short))
        - last_message = item[:last_message]
        - show_preview = last_message.present? && last_message.content != item[:title]
        %li
          = link_to conversation_path(id: conversation.id),
            class: "l2m-history-card",
            "aria-label": t("conversation_history.index.resume_named", title: truncate(title, length: 80)) do
            %span.l2m-history-card-icon{"aria-hidden": "true"}
              = heroicon "chat-bubble-left-right", options: { class: "h-6 w-6" }

            .l2m-history-card-content
              .l2m-history-title-row
                %h2= truncate(title, length: 80)
                - if item[:category].present?
                  %span.l2m-history-category= display_category_name(item[:category])

              - if show_preview
                %p.l2m-history-preview
                  %span.l2m-history-role= last_message.speaker? ? t("conversation_history.index.you") : t("conversation_history.index.partner")
                  %span= truncate(last_message.content, length: 130)
              - else
                %p.l2m-history-preview.is-placeholder= t("conversation_history.index.ready_to_resume")

              .l2m-history-meta
                %span= t("conversation_history.index.messages_count", count: item.fetch(:message_count))
                %time{datetime: item.fetch(:last_activity_at).iso8601}
                  = t("conversation_history.index.last_activity", date: l(item.fetch(:last_activity_at), format: :short))

            %span.l2m-history-resume{"aria-hidden": "true"}
              %span= t("conversation_history.index.resume")
              = heroicon "arrow-right", options: { class: "h-5 w-5" }
  - else
    .l2m-history-empty{"aria-labelledby": "conversation-history-empty-title"}
      %span.l2m-history-empty-icon{"aria-hidden": "true"}
        = heroicon "chat-bubble-left-right", options: { class: "h-8 w-8" }
      %h2#conversation-history-empty-title= t("conversation_history.index.empty_title")
      %p= t("conversation_history.index.empty_copy")
      = link_to new_conversation_path, class: "l2m-button l2m-history-new-button" do
        = heroicon "plus", options: { class: "h-5 w-5", "aria-hidden": "true" }
        %span= t("conversation_history.index.empty_action")
