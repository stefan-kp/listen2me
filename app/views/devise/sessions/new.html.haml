- content_for :title, t(".sign_in")

.l2m-auth-page{"aria-labelledby": "sign-in-title"}
  .l2m-auth-card
    .l2m-auth-heading
      %p.l2m-eyebrow= t(".eyebrow")
      %h1#sign-in-title= t(".sign_in")
      %p= t(".intro")

    = form_for resource,
      as: resource_name,
      url: session_path(resource_name),
      html: { class: "l2m-auth-form" } do |f|
      .l2m-field
        = f.label :email, t(".email")
        = f.email_field :email,
          autofocus: true,
          autocomplete: "email",
          class: "l2m-input",
          placeholder: t(".email_placeholder")

      .l2m-field
        = f.label :password, t(".password")
        = f.password_field :password,
          autocomplete: "current-password",
          class: "l2m-input",
          placeholder: t(".password_placeholder")

      - if devise_mapping.rememberable?
        = f.label :remember_me, class: "l2m-checkbox-row" do
          = f.check_box :remember_me
          %span= t(".remember_me")

      = f.submit t(".sign_in"), class: "l2m-button l2m-button-dark"

    = render "devise/shared/google_auth"
    = render "devise/shared/links"
