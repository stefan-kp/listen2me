- content_for :title, t(".sign_up")

.l2m-auth-page{"aria-labelledby": "sign-up-title"}
  .l2m-auth-card.l2m-auth-card-wide
    .l2m-auth-heading
      %p.l2m-eyebrow= t(".eyebrow")
      %h1#sign-up-title= t(".sign_up")
      %p= t(".intro")

    = form_for resource,
      as: resource_name,
      url: registration_path(resource_name),
      html: { class: "l2m-auth-form" } do |f|
      = render "devise/shared/error_messages", resource: resource

      .l2m-field-row
        .l2m-field
          = f.label :first_name, t(".first_name")
          = f.text_field :first_name,
            autofocus: true,
            autocomplete: "given-name",
            class: "l2m-input",
            placeholder: t(".first_name_placeholder")

        .l2m-field
          = f.label :last_name, t(".last_name")
          = f.text_field :last_name,
            autocomplete: "family-name",
            class: "l2m-input",
            placeholder: t(".last_name_placeholder")

      .l2m-field
        = f.label :email, t(".email")
        = f.email_field :email,
          autocomplete: "email",
          class: "l2m-input",
          placeholder: t(".email_placeholder")

      .l2m-field
        = f.label :password, t(".password")
        = f.password_field :password,
          autocomplete: "new-password",
          class: "l2m-input",
          placeholder: t(".password_placeholder")
        - if @minimum_password_length
          %small= t("devise.shared.minimum_password_length", count: @minimum_password_length)

      .l2m-field
        = f.label :password_confirmation, t(".password_confirmation")
        = f.password_field :password_confirmation,
          autocomplete: "new-password",
          class: "l2m-input",
          placeholder: t(".password_confirmation_placeholder")

      = f.submit t(".sign_up"), class: "l2m-button l2m-button-dark"

    = render "devise/shared/links"
