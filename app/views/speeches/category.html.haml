.l2m-page{"aria-labelledby": "category-title"}
  .l2m-conversation-topbar
    = link_to speeches_path, class: "l2m-back-link", "aria-label": t(".back_to_categories") do
      %span{"aria-hidden": "true"} ←
      = t(".back")

  .l2m-view-heading
    %div
      %p.l2m-eyebrow= t(".category_label", default: "Satzkategorie")
      %h1#category-title
        = @category.name
    = heroicon @category.icon_name, options: { class: "h-10 w-10 text-emerald-800", "aria-hidden": "true" }

  = render "text_form"

  %section.l2m-phrases-section{"aria-labelledby": "sentences-title"}
    .l2m-section-heading
      %div
        %p.l2m-section-kicker= t(".quick_sentences", default: "Schnelle Sätze")
        %h2#sentences-title= t(".category_sentences", category: @category.name)
    .l2m-phrase-grid{role: "list", "aria-label": t(".sentences_list")}
      - if @sentences.any?
        = render partial: "sentence", collection: @sentences
      - else
        %p.l2m-empty-state{"aria-label": t(".no_sentences")}
          = t(".no_sentences")
