.l2m-phrase-card-wrap{id: dom_id(sentence), role: "listitem"}
  %button.l2m-phrase-card{
    type: "button",
    data: {
      action: "click->communicator#choosePhrase",
      communicator_target: "card",
      communicator_text_param: sentence.content,
      communicator_track_url_param: speak_speech_path(id: sentence.id),
      direct_label: t(".speak_sentence", text: sentence.content),
      draft_label: t(".draft_sentence", text: sentence.content, default: "Satz zuerst schreiben: #{sentence.content}")
    },
    "aria-label": t(".speak_sentence", text: sentence.content)}
    %span.l2m-phrase-content= sentence.content
    %span.l2m-phrase-meta
      - if sentence.category.present?
        %span= sentence.category.name
      %small{
        data: {
          communicator_target: "modeHint",
          direct_text: t(".direct_action", default: "Sofort sprechen"),
          draft_text: t(".draft_action", default: "Erst schreiben")
        }}
        = t(".direct_action", default: "Sofort sprechen")
