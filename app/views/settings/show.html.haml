- content_for :title, t(".title")

.l2m-page.l2m-settings-page{"aria-labelledby": "settings-title"}
  .l2m-view-heading
    %div
      %p.l2m-eyebrow= t(".eyebrow")
      %h1#settings-title= t(".title")
    %p.l2m-view-hint= t(".intro")

  = render "devise/shared/error_messages", resource: current_user

  .l2m-settings-shell{data: { controller: "tabs" }}
    %nav.l2m-settings-tabs{role: "tablist", "aria-label": t(".sections")}
      = link_to "#profile",
        id: "settings-profile-tab",
        class: "l2m-settings-tab",
        role: "tab",
        "aria-controls": "profile",
        "aria-selected": "false",
        data: { tabs_target: "tab", action: "click->tabs#switch keydown->tabs#keydown", tab: "profile" } do
        = heroicon "user", options: { class: "h-5 w-5", "aria-hidden": "true" }
        %span= t(".about_me")

      = link_to "#voice-device",
        id: "settings-device-tab",
        class: "l2m-settings-tab",
        role: "tab",
        "aria-controls": "voice-device",
        "aria-selected": "false",
        data: { tabs_target: "tab", action: "click->tabs#switch keydown->tabs#keydown", tab: "voice-device" } do
        = heroicon "speaker-wave", options: { class: "h-5 w-5", "aria-hidden": "true" }
        %span= t(".device")

      = link_to "#system",
        id: "settings-system-tab",
        class: "l2m-settings-tab",
        role: "tab",
        "aria-controls": "system",
        "aria-selected": "false",
        data: { tabs_target: "tab", action: "click->tabs#switch keydown->tabs#keydown", tab: "system" } do
        = heroicon "sparkles", options: { class: "h-5 w-5", "aria-hidden": "true" }
        %span= t(".system")

      = link_to "#account",
        id: "settings-account-tab",
        class: "l2m-settings-tab",
        role: "tab",
        "aria-controls": "account",
        "aria-selected": "false",
        data: { tabs_target: "tab", action: "click->tabs#switch keydown->tabs#keydown", tab: "account" } do
        = heroicon "user-circle", options: { class: "h-5 w-5", "aria-hidden": "true" }
        %span= t(".account")

    .l2m-settings-panels
      %section#profile.l2m-settings-panel{
        role: "tabpanel",
        "aria-labelledby": "settings-profile-tab",
        data: { tabs_target: "panel", panel: "profile" }}
        .l2m-settings-panel-heading
          %div
            %p.l2m-section-kicker= t(".personal")
            %h2= t(".about_settings")
          = heroicon "user", options: { class: "h-7 w-7", "aria-hidden": "true" }
        %p.l2m-settings-copy= t(".about_description")

        = form_with model: current_user, url: settings_path, id: "profile-settings-form", class: "l2m-settings-form" do |f|
          .l2m-field
            = f.label :description, t(".description_label")
            = f.text_area :description,
              class: "l2m-input",
              rows: 5,
              maxlength: 2000,
              placeholder: t(".description_placeholder")
            %small= t(".description_help")

          .l2m-settings-actions
            = f.submit t(".save"), class: "l2m-button l2m-button-dark"

      %section#voice-device.l2m-settings-panel{
        role: "tabpanel",
        "aria-labelledby": "settings-device-tab",
        data: {
          tabs_target: "panel",
          panel: "voice-device",
          controller: "device-check"
        }}
        .l2m-settings-panel-heading
          %div
            %p.l2m-section-kicker= t(".device_kicker")
            %h2= t(".device_title")
          = heroicon "speaker-wave", options: { class: "h-7 w-7", "aria-hidden": "true" }
        %p.l2m-settings-copy= t(".device_description")

        = form_with model: current_user, url: settings_path, id: "voice-settings-form", class: "l2m-settings-form" do |f|
          %fieldset.l2m-profile-choice
            %legend= t(".voice_provider_label")
            %p= t(".voice_provider_help")
            .l2m-profile-choice-grid.l2m-voice-provider-grid
              = f.label :speech_provider_openai,
                class: ["l2m-profile-choice-card", ("is-disabled" unless @speech_provider_status["openai"])] do
                = f.radio_button :speech_provider, "openai",
                  disabled: !@speech_provider_status["openai"]
                %span.l2m-choice-check{"aria-hidden": "true"} ✓
                = heroicon "sparkles", options: { class: "h-6 w-6", "aria-hidden": "true" }
                %strong= t(".provider_openai")
                %small= t(".provider_openai_description")
                %em= @speech_provider_status["openai"] ? t(".provider_recommended") : t(".provider_unavailable")

              = f.label :speech_provider_browser, class: "l2m-profile-choice-card" do
                = f.radio_button :speech_provider, "browser"
                %span.l2m-choice-check{"aria-hidden": "true"} ✓
                = heroicon "device-phone-mobile", options: { class: "h-6 w-6", "aria-hidden": "true" }
                %strong= t(".provider_browser")
                %small= t(".provider_browser_description")
                %em= t(".provider_always_available")

              = f.label :speech_provider_cartesia,
                class: ["l2m-profile-choice-card", ("is-disabled" unless @speech_provider_status["cartesia"])] do
                = f.radio_button :speech_provider, "cartesia",
                  disabled: !@speech_provider_status["cartesia"]
                %span.l2m-choice-check{"aria-hidden": "true"} ✓
                = heroicon "bolt", options: { class: "h-6 w-6", "aria-hidden": "true" }
                %strong= t(".provider_cartesia")
                %small= t(".provider_cartesia_description")
                %em= @speech_provider_status["cartesia"] ? t(".provider_limited") : t(".provider_unavailable")

              = f.label :speech_provider_elevenlabs,
                class: ["l2m-profile-choice-card", ("is-disabled" unless @speech_provider_status["elevenlabs"])] do
                = f.radio_button :speech_provider, "elevenlabs",
                  disabled: !@speech_provider_status["elevenlabs"]
                %span.l2m-choice-check{"aria-hidden": "true"} ✓
                = heroicon "musical-note", options: { class: "h-6 w-6", "aria-hidden": "true" }
                %strong= t(".provider_elevenlabs")
                %small= t(".provider_elevenlabs_description")
                %em= @speech_provider_status["elevenlabs"] ? t(".provider_limited") : t(".provider_unavailable")

          %p.l2m-settings-note
            = heroicon "shield-check", options: { class: "h-5 w-5", "aria-hidden": "true" }
            %span= t(".voice_provider_privacy")

          .l2m-settings-actions
            = f.submit t(".save_voice"), class: "l2m-button l2m-button-dark"

        .l2m-settings-divider

        .l2m-audio-checks
          .l2m-audio-check
            %div
              = heroicon "speaker-wave", options: { class: "h-6 w-6", "aria-hidden": "true" }
              %span
                %strong= t(".voice_test_title")
                %small= t(".voice_test_copy")
            %button.l2m-button.l2m-button-secondary{
              type: "button",
              data: { action: "click->device-check#testVoice" }}
              = t(".test")

          .l2m-audio-check
            %div
              = heroicon "microphone", options: { class: "h-6 w-6", "aria-hidden": "true" }
              %span
                %strong= t(".microphone_test_title")
                %small= t(".microphone_test_copy")
            %button.l2m-button.l2m-button-secondary{
              type: "button",
              data: { action: "click->device-check#testMicrophone" }}
              = t(".test")

        %p.l2m-audio-status{
          role: "status",
          "aria-live": "polite",
          data: {
            device_check_target: "status",
            voice_success: t(".voice_success"),
            voice_success_openai: t(".voice_success_openai"),
            voice_success_browser: t(".voice_success_browser"),
            voice_success_cartesia: t(".voice_success_cartesia"),
            voice_success_elevenlabs: t(".voice_success_elevenlabs"),
            voice_error: t(".voice_error"),
            microphone_success: t(".microphone_success"),
            microphone_error: t(".microphone_error"),
            testing: t(".testing"),
            test_sentence: t(".test_sentence")
          }}

        %p.l2m-settings-note
          = heroicon "shield-check", options: { class: "h-5 w-5", "aria-hidden": "true" }
          %span= t(".personal_voice_later")

      %section#system.l2m-settings-panel{
        role: "tabpanel",
        "aria-labelledby": "settings-system-tab",
        data: { tabs_target: "panel", panel: "system" }}
        .l2m-settings-panel-heading
          %div
            %p.l2m-section-kicker= t(".ai_kicker")
            %h2= t(".llm_settings")
          = heroicon "sparkles", options: { class: "h-7 w-7", "aria-hidden": "true" }
        %p.l2m-settings-copy= t(".llm_settings_description")

        = form_with model: current_user, url: settings_path, id: "ai-settings-form", class: "l2m-settings-form" do |f|
          %fieldset.l2m-profile-choice
            %legend= t(".model_profile_label")
            %p= t(".model_profile_help")
            .l2m-profile-choice-grid
              = f.label :suggestion_model_profile_fast, class: "l2m-profile-choice-card" do
                = f.radio_button :suggestion_model_profile, "fast",
                  checked: current_user.suggestion_model_profile != "cheap"
                %span.l2m-choice-check{"aria-hidden": "true"} ✓
                = heroicon "bolt", options: { class: "h-6 w-6", "aria-hidden": "true" }
                %strong= t(".model_profile_fast")
                %small= t(".model_profile_fast_description")
                %em= t(".recommended")

              = f.label :suggestion_model_profile_cheap, class: "l2m-profile-choice-card" do
                = f.radio_button :suggestion_model_profile, "cheap",
                  checked: current_user.suggestion_model_profile == "cheap"
                %span.l2m-choice-check{"aria-hidden": "true"} ✓
                = heroicon "banknotes", options: { class: "h-6 w-6", "aria-hidden": "true" }
                %strong= t(".model_profile_cheap")
                %small= t(".model_profile_cheap_description")

          %p.l2m-settings-note
            = heroicon "shield-check", options: { class: "h-5 w-5", "aria-hidden": "true" }
            %span= t(".proxy_explanation")

          .l2m-settings-actions
            = f.submit t(".save_ai"), class: "l2m-button l2m-button-dark"

        .l2m-settings-divider

        .l2m-settings-subsection
          %div
            %h3= t(".conversation_summary")
            %p.l2m-settings-copy= t(".conversation_summary_explanation")
          = button_to generate_summary_settings_path,
            method: :post,
            class: "l2m-button l2m-button-secondary",
            data: { controller: "loading-button", loading_button_text_value: t(".generating_summary"), turbo_submits_with: "" } do
            = heroicon "arrow-path", options: { class: "h-5 w-5", "data-loading-button-target": "icon", "aria-hidden": "true" }
            %span{data: { loading_button_target: "label" }}= t(".generate_summary")

        - if current_user.conversation_summary.present?
          .l2m-summary-card
            %small= t(".last_generated", time: l(current_user.summary_generated_at, format: :long))
            .l2m-summary-content= markdown_to_html(current_user.conversation_summary)
        - else
          %p.l2m-empty-state= t(".no_summary")

      %section#account.l2m-settings-panel{
        role: "tabpanel",
        "aria-labelledby": "settings-account-tab",
        data: { tabs_target: "panel", panel: "account" }}
        .l2m-settings-panel-heading
          %div
            %p.l2m-section-kicker= t(".account_kicker")
            %h2= t(".account_title")
          = heroicon "user-circle", options: { class: "h-7 w-7", "aria-hidden": "true" }
        %p.l2m-settings-copy= t(".account_description")

        .l2m-account-summary
          %span.l2m-account-avatar{"aria-hidden": "true"}
            = "#{current_user.first_name.to_s.first}#{current_user.last_name.to_s.first}".upcase
          %span
            %strong= [current_user.first_name, current_user.last_name].compact.join(" ")
            %small= current_user.email

        .l2m-account-actions
          = link_to edit_user_registration_path, class: "l2m-button l2m-button-secondary" do
            = heroicon "pencil-square", options: { class: "h-5 w-5", "aria-hidden": "true" }
            = t(".edit_account")
          = button_to destroy_user_session_path, method: :delete, class: "l2m-button l2m-button-dark" do
            = heroicon "arrow-right-on-rectangle", options: { class: "h-5 w-5", "aria-hidden": "true" }
            = t(".sign_out")
