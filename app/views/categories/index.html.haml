- content_for :title, t("category_management.index.title")

.l2m-page.l2m-categories-page{"aria-labelledby": "categories-title"}
  .l2m-view-heading
    %div
      %p.l2m-eyebrow= t("category_management.index.eyebrow")
      %h1#categories-title= t("category_management.index.title")
    %p.l2m-view-hint= t("category_management.index.intro")

  .l2m-category-toolbar
    .l2m-category-summary{role: "status"}
      = heroicon "rectangle-stack", options: { class: "l2m-category-summary-icon", "aria-hidden": "true" }
      %span
        %strong= t("category_management.index.category_count", count: @categories.size)
        %small= t("category_management.index.summary_hint")
    = link_to new_category_path,
      class: "l2m-button l2m-button-dark l2m-category-new-button" do
      = heroicon "plus", options: { class: "l2m-category-button-icon", "aria-hidden": "true" }
      = t("category_management.index.new_category")

  - if @categories.any?
    %ul.l2m-category-list{
      role: "list",
      "aria-label": t("category_management.index.categories_list")}
      = render @categories
  - else
    %section.l2m-category-empty{"aria-labelledby": "empty-categories-title"}
      %span.l2m-category-empty-icon{"aria-hidden": "true"}
        = heroicon "plus-circle", options: { class: "l2m-category-empty-icon-svg" }
      %h2#empty-categories-title= t("category_management.index.empty_title")
      %p= t("category_management.index.empty_description")
      = link_to new_category_path, class: "l2m-button l2m-button-dark" do
        = heroicon "plus", options: { class: "l2m-category-button-icon", "aria-hidden": "true" }
        = t("category_management.index.empty_action")
