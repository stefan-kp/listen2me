- submit_action = category.new_record? ? "create" : "update"
- legacy_icon_name = category.legacy_icon_name
- icon_names = legacy_icon_name ? [legacy_icon_name, *Category::ICONS] : Category::ICONS

= form_with model: category,
  url: (category.new_record? ? categories_path : category_path(id: category.id)),
  class: "l2m-category-form" do |f|
  - if category.errors.any?
    .l2m-form-error{role: "alert", data: { turbo_cache: "false" }}
      = heroicon "exclamation-circle", options: { class: "l2m-category-error-icon", "aria-hidden": "true" }
      %div
        %h2= t("category_management.form.error_heading", count: category.errors.count)
        %ul
          - category.errors.full_messages.each do |message|
            %li= message

  .l2m-field
    = f.label :name, t("category_management.form.name_label")
    = f.text_field :name,
      class: "l2m-input",
      required: true,
      maxlength: 60,
      autofocus: true,
      autocomplete: "off",
      placeholder: t("category_management.form.name_placeholder"),
      "aria-invalid": category.errors[:name].any?,
      "aria-describedby": "category-name-help"
    %small#category-name-help= t("category_management.form.name_help")

  %fieldset.l2m-category-icon-fieldset{
    "aria-describedby": "category-icon-help",
    "aria-invalid": category.errors[:icon_name].any?.to_s}
    %legend= t("category_management.form.icon_label")
    %p#category-icon-help= t("category_management.form.icon_help")

    .l2m-category-icon-grid
      - icon_names.each do |icon_name|
        .l2m-category-icon-option
          = f.radio_button :icon_name,
            icon_name,
            class: "l2m-category-icon-radio",
            required: true,
            id: "category_icon_name_#{icon_name}"
          = f.label "icon_name_#{icon_name}", class: "l2m-category-icon-choice" do
            = heroicon icon_name, options: { class: "l2m-category-choice-icon", "aria-hidden": "true" }
            %span
              - if icon_name == legacy_icon_name
                = t("category_management.form.current_icon")
              - else
                = t("category_management.icons.#{icon_name}")

  .l2m-category-form-actions
    = link_to t("category_management.common.cancel"),
      categories_path,
      class: "l2m-button l2m-button-secondary"
    = f.submit t("category_management.form.submit.#{submit_action}"),
      class: "l2m-button l2m-button-dark"
