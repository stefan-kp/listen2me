- content_for :title, t("category_management.edit.title")

.l2m-page.l2m-category-editor-page{"aria-labelledby": "category-editor-title"}
  = link_to categories_path, class: "l2m-back-link l2m-category-back-link" do
    = heroicon "arrow-left", options: { class: "l2m-category-button-icon", "aria-hidden": "true" }
    = t("category_management.common.back")

  .l2m-view-heading
    %div
      %p.l2m-eyebrow= t("category_management.edit.eyebrow")
      %h1#category-editor-title= t("category_management.edit.title")
    %p.l2m-view-hint= t("category_management.edit.intro", name: display_category_name(@category))

  .l2m-category-form-card
    = render "form", category: @category
