- sentence_count = category.sentences.size
- category_name = display_category_name(category)
- delete_confirmation = t("category_management.index.confirm_delete", name: category_name, count: sentence_count)

%li.l2m-category-card{id: dom_id(category), "aria-labelledby": "category-name-#{category.id}"}
  .l2m-category-card-main
    %span.l2m-category-card-icon{"aria-hidden": "true"}
      = heroicon category.icon_name_for_display, options: { class: "l2m-category-card-icon-svg" }
    .l2m-category-card-copy
      %h2{id: "category-name-#{category.id}"}= category_name
      %p= t("category_management.index.sentences_count", count: sentence_count)

  .l2m-category-actions{
    role: "group",
    "aria-label": t("category_management.index.actions_label", name: category_name)}
    = link_to category_speech_path(id: category.id),
      class: "l2m-category-action l2m-category-action-primary" do
      = heroicon "chat-bubble-left", options: { class: "l2m-category-action-icon", "aria-hidden": "true" }
      %span= t("category_management.index.open_sentences")

    = link_to edit_category_path(id: category.id),
      id: "edit_category_#{category.id}",
      class: "l2m-category-action" do
      = heroicon "pencil-square", options: { class: "l2m-category-action-icon", "aria-hidden": "true" }
      %span= t("category_management.index.edit")

    = button_to category_path(id: category.id),
      method: :delete,
      id: "delete_category_#{category.id}",
      class: "l2m-category-action l2m-category-action-danger",
      form: { class: "l2m-category-delete-form", data: { turbo_confirm: delete_confirmation } } do
      = heroicon "trash", options: { class: "l2m-category-action-icon", "aria-hidden": "true" }
      %span= t("category_management.index.delete")
